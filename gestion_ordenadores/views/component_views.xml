<odoo>
    <!-- Vista lista de Componentes -->
    <record id="view_gestion_component_list" model="ir.ui.view">
        <field name="name">gestion.componente.list</field>
        <field name="model">gestion.componente</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="price" />
            </list>
        </field>
    </record>

    <!-- Vista formulario de Componentes -->
    <record id="view_gestion_component_form" model="ir.ui.view">
        <field name="name">gestion.componente.form</field>
        <field name="model">gestion.componente</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="price" />
                        <field name="currency_id" invisible="1"/>
                        <field name="especificaciones"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción para abrir Componentes -->
    <record id="action_gestion_componentes" model="ir.actions.act_window">
        <field name="name">Listado de Componentes</field>
        <field name="res_model">gestion.componente</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
